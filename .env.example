# Published image tag; use a release tag such as v1.0.0 to pin a version
MULTIFRP_IMAGE_TAG=latest
# Management website and Windows client connection hostname
MULTIFRP_HOST=manage.example.com
# Backend HTTP listening address used by Nginx and the health check
MULTIFRP_HTTP_BIND=127.0.0.1:8080
# Optional separate public address shown for tunnels
MULTIFRP_PUBLIC_DOMAIN=frp.example.com
MULTIFRP_ADMIN_USER=admin
MULTIFRP_ADMIN_PASSWORD=
# Allocation pool only; ports are listened on when tunnels are approved and enabled
MULTIFRP_PORT_FIRST=30000
MULTIFRP_PORT_LAST=30099
MULTIFRP_TIMEZONE=Asia/Shanghai
